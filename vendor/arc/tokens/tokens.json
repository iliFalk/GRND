  "shadow": {
    "note": "One shadow for a surface that sits above another: the dialog rises, the sheet rises from the bottom.",
    "panel": "0 24px 64px rgba(0, 0, 0, 0.6)",
    "sheet": "0 -24px 64px rgba(0, 0, 0, 0.6)",
    "toast": "0 8px 32px rgba(0, 0, 0, 0.4)"
  },
  "effect": {
    "note": "The ambient texture and the two motion effects. Alpha belongs in the token, and a period is a value like any other.",
    "scan": "rgba(0, 212, 255, 0.05)",
    "scan-period": "4px",
    "shimmer": "rgba(0, 212, 255, 0.12)",
    "sweep": "rgba(0, 212, 255, 0.30)",
    "glitch-a": "rgba(0, 212, 255, 0.30)",
    "glitch-b": "rgba(255, 6, 181, 0.30)",
