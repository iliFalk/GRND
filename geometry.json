{
  "_note": "The relations GRND's screens must satisfy under the ARC theme. Steps are the app's 4 px scale plus the system's spacing tokens, which the ARC theme resolves on the page; add a step here only when the design actually uses it.",
  "steps": [
    "--arc-space-1",
    "--arc-space-2",
    "--arc-space-3",
    "--arc-space-4",
    "--arc-space-5",
    "--arc-space-6",
    "--arc-space-8",
    "--arc-control-height-m"
  ],
  "allow": [
    20,
    28,
    36
  ],
  "rhythm": {
    "scope": "main *"
  },
  "inset": [
    {
      "container": "main > section",
      "child": ":scope > *"
    },
    {
      "container": "main > div",
      "child": ":scope > *"
    }
  ],
  "rows": [
    {
      "container": ".arc-panel",
      "child": ".arc-item"
    }
  ],
  "columns": [
    {
      "grid": ".arc-table",
      "row": ".arc-table__row"
    }
  ],
  "padding": [
    {
      "selector": ".arc-panel",
      "min": "--arc-space-4",
      "sides": [
        "top",
        "left"
      ]
    }
  ]
}
