{
  "meta": {
    "name": "ARC",
    "version": "2.2.0",
    "master_frame": "390x844",
    "note": "The single source of every value. tools/build.py writes dist/arc.css from this file; tools/contrast.py measures the pairs declared under contrast."
  },
