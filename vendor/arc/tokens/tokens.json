      "teal-700": "#0A6E7E",
      "honey-800": "#8A6100",
      "leaf-800": "#1A6642",
      "crit-800": "#A0108A"
    }
  },
  "semantic": {
    "bg": {
      "void": "{void}",
      "ambient": "{ambient}",
      "base": "{base}",
      "panel": "{layer-1}",
      "raised": "{layer-2}"
    },
    "line": {
      "soft": "rgba(120, 190, 215, 0.18)",
      "hair": "#44697C",
      "strong": "rgba(0, 212, 255, 0.65)"
    },
    "accent": {
      "primary": "{cyan-400}",
      "strong": "{cyan-200}",
      "muted": "{cyan-700}"
    },
    "status": {
      "attention": "{honey-500}",
      "critical": "{telemagenta-300}",
      "error": "{signal-300}",
      "ok": "{leaf-500}",
      "attention-fill": "{honey-600}",
      "attention-press": "{honey-700}",
      "ok-fill": "{leaf-700}",
      "error-fill": "{blood-600}",
      "critical-fill": "{telemagenta-500}"
    },
    "graphic": {
      "series": "{cyan-400}",
      "area": "rgba(0, 212, 255, 0.12)"
    },
    "fg": {
      "high": "{blue-050}",
      "medium": "{blue-300}",
      "low": "{blue-500}",
      "faint": "{blue-700}",
      "invert": "{ambient}",
      "on-dark": "{white}"
    },
    "opacity": {
      "ambient": "0.55"
    },
    "overlay": {
      "scrim": "rgba(5, 8, 13, 0.72)"
    }
  },
  "fluid": {
    "note": "A percentage on the block axis resolves against the containing block's inline size, so spacing scales through these units instead.",
    "unit": {
      "min": "0.875rem",
      "pref": "0.861rem + 0.571cqi",
      "max": "1.375rem"
    },
    "text-unit": {
      "min": "1rem",
      "pref": "0.94rem + 0.247cqi",
      "max": "1.125rem"
    }
  },
  "space": {
    "1": 0.25,
    "2": 0.5,
    "3": 0.75,
    "4": 1,
    "5": 1.5,
    "6": 2,
    "8": 3,
    "10": 4,
    "12": 6
  },
  "size_note": "Multipliers of --arc-fs. Rem based, so 200% zoom keeps the hierarchy.",
  "size": {
    "display": 2.5,
    "h1": 1.75,
    "h2": 1.375,
    "h3": 1.125,
    "label": 0.8125,
    "micro": 0.75,
    "body": 1,
    "small": 0.875,
    "readout": 3.5
  },
  "control": {
    "note": "A touch target is a physical constraint: no control is shorter than 44px, so there is no S size. Height grows with the frame and then stops.",
    "height-m": "clamp(44px, calc(var(--arc-u) * 2.75), 48px)",
    "height-l": "clamp(52px, calc(var(--arc-u) * 3.25), 56px)"
  },
  "tracking": {
    "display": "0.02em",
    "label": "0.10em",
    "micro": "0.14em",
    "body": "0"
  },
  "radius": {
    "note": "Zero, and one chamfer shared by button, chip and field. The pill survives only for a round status element.",
    "none": "0px",
    "chamfer": "calc(var(--arc-u) * 0.75)",
    "pill": "9999px"
  },
  "stroke": {
    "hair": "1px",
    "focus": "2px",
    "chart": "2px"
  },
  "chart": {
    "note": "A line chart is SVG. The marks are emitted by tools/chart.py; only the values here and in tokens reach the stylesheet. Plot geometry — the viewBox and its paddings — belongs to the generator, because it is a coordinate system and not a style.",
    "point": "3px",
    "height": "120px"
  },
  "glow": {
    "note": "A glow marks the top step of a ramp. It is a blurred copy in the element's own hue, or the glyph shadow for a value. Static only.",
    "text-1": "0 0 3px currentColor",
    "text-2": "0 0 2px currentColor",
    "halo-blur": "4px",
    "halo-opacity": "0.30",
    "min-shape": "calc(var(--arc-u) * 1.5)",
    "min-text": "var(--arc-fs-body)"
  },
  "motion": {
    "instant": "50ms",
    "quick": "120ms",
    "fast": "220ms",
    "normal": "320ms",
    "deliberate": "460ms",
    "ease-out": "cubic-bezier(0.2, 0, 0, 1)",
    "ease-in": "cubic-bezier(0.6, 0, 1, 1)",
    "ease-snap": "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease-step": "steps(2, end)",
    "skeleton": "1.1s",
    "sweep": "620ms",
    "glitch": "240ms",
    "caret": "1s"
  },
  "typeface": {
    "ui": "Barlow Semi Condensed",
    "mono": "JetBrains Mono",
    "note": "Both SIL OFL, shipped as WOFF2 in assets/fonts. Rajdhani was the game's own face and lost on legibility at 12px: docs/compare-typefaces.png."
  },
